<Window x:Class="Scanner.Server.LabelVersionsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="OEPS Scanner · Label versions &amp; JSON" Width="840" Height="850" MinWidth="640" MinHeight="500"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
 <Window.Resources>
  <Style x:Key="ReferenceText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="IsReadOnly" Value="True"/>
   <Setter Property="FontFamily" Value="Consolas"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="VerticalContentAlignment" Value="Top"/>
   <Setter Property="Margin" Value="0"/>
  </Style>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12">
   <TextBlock Text="Label versions &amp; JSON" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <StackPanel Orientation="Horizontal">
    <TextBlock Text="Label version" Margin="0,0,10,0"/>
    <ComboBox x:Name="VersionSelector" ItemsSource="{Binding Versions}" DisplayMemberPath="Name" SelectedIndex="0" Width="180"/>
   </StackPanel>
  </StackPanel>
  <ScrollViewer x:Name="ReferenceScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel DataContext="{Binding SelectedItem, ElementName=VersionSelector}" Margin="0,0,6,0">
    <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14">
     <StackPanel>
      <TextBlock Text="Data Matrix format" Style="{StaticResource SectionTitle}"/>
      <TextBox Text="{Binding Format, Mode=OneWay}" Style="{StaticResource ReferenceText}"/>
      <TextBlock Text="Validation rules" Style="{StaticResource SectionTitle}" Margin="0,16,0,6"/>
      <TextBlock Text="n = digit (0–9) · y = uppercase letter (A–Z) · h = uppercase letter or digit" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,12"/>
      <ItemsControl ItemsSource="{Binding Rules}">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Grid Margin="0,0,0,12">
         <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Field}" FontWeight="SemiBold" VerticalAlignment="Top"/>
         <TextBlock Grid.Column="1" Text="{Binding Rule}" TextWrapping="Wrap" VerticalAlignment="Top"/>
        </Grid>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Checksum calculation" Style="{StaticResource SectionTitle}" Margin="0,4,0,8"/>
      <TextBlock Text="{Binding ChecksumRule}" TextWrapping="Wrap"/>
      <TextBlock Text="Complete Data Matrix example" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"/>
      <TextBox Text="{Binding ExamplePayload, Mode=OneWay}" Style="{StaticResource ReferenceText}"/>
     </StackPanel>
    </Border>
    <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14" Margin="0,12,0,0">
     <StackPanel>
      <TextBlock Text="JSON sent to clients" Style="{StaticResource SectionTitle}"/>
      <TextBox Text="{Binding ExampleJson, Mode=OneWay}" Style="{StaticResource ReferenceText}"/>
      <TextBlock Text="label_version is a JSON number. oeps_pn, lot and quantity are JSON strings. Quantity keeps its exact precision and formatting. The checksum is verified by the server and omitted from the JSON." TextWrapping="Wrap" Margin="0,10,0,0"/>
      <TextBlock Text="After validation, readings are sent to connected clients. The same payload is suppressed for 500 ms after its previous broadcast; different payloads are independent. A continuously visible label can be sent again after that interval." TextWrapping="Wrap" Margin="0,10,0,0"/>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <Button Grid.Row="2" Content="Close" IsCancel="True" Click="CloseReference" HorizontalAlignment="Right" MinWidth="90" Margin="0,12,0,0"/>
 </Grid>
</Window>
