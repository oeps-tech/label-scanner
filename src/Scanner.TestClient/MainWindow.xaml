<Window x:Class="Scanner.TestClient.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:desktop="clr-namespace:Scanner.Desktop;assembly=Scanner.Desktop"
 Title="OEPS Scanner Client" Width="760" Height="590" MinWidth="600" MinHeight="480" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
 <DockPanel><desktop:ReleaseFooter DockPanel.Dock="Bottom"/>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
  <TextBlock Text="OEPS Scanner Client" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
  <WrapPanel><TextBlock Text="Server" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding Host}" Width="200"/><TextBox Text="{Binding Port}" Width="80"/><Button Content="{Binding ConnectLabel}" Command="{Binding ConnectCommand}"/></WrapPanel>
  <TextBlock Text="{Binding Status}" Margin="0,10,0,10" TextWrapping="Wrap"/>
  <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14"><StackPanel>
   <TextBlock Text="Latest data" Style="{StaticResource SectionTitle}"/>
   <Grid Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Text="Label version"/><TextBlock Grid.Column="1" Text="{Binding LabelVersion}"/>
    <TextBlock Grid.Row="1" Text="OEPS PN"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OepsPn}"/>
    <TextBlock Grid.Row="2" Text="Lot"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Lot}"/>
    <TextBlock Grid.Row="3" Text="Quantity"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Quantity}"/>
   </Grid>
   <TextBox Text="{Binding Json, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" Height="190" VerticalScrollBarVisibility="Auto"/>
  </StackPanel></Border>
  <TextBlock Text="{Binding Received}" Margin="0,12,0,0"/>
  <TextBlock Text="Data only · no screenshots, feedback or stored scan history" FontSize="11" Margin="0,5,0,0"/>
 </StackPanel></ScrollViewer></DockPanel>
</Window>
